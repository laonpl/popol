# ─────────────────────────────────────────────
# Backend 환경변수
# 로컬: 이 파일을 backend/.env 로 복사해 값 입력
# 배포: Render 대시보드 → Environment에 같은 키로 입력
# ─────────────────────────────────────────────

# 서버 포트 (Render는 자동 주입)
PORT=5000

# 프론트엔드 URL - CORS 허용 도메인 (쉼표로 여러 개 가능)
# 로컬 개발(localhost)은 기본 허용, 배포 시 Vercel 주소 필수
FRONTEND_URL=https://your-app.vercel.app

# ── AI (Vertex AI / Gemini) ─────────────────────
# API 키만 쓰면 Vertex AI Express 모드로 호출됩니다.
# 서비스계정/ADC로 표준 Vertex AI를 쓰려면 VERTEX_AI_AUTH_MODE=adc 를 추가하세요.
VERTEX_AI_PROJECT_ID=your_gcp_project_id
VERTEX_AI_LOCATION=asia-northeast3
GEMINI_API_KEY=your_gemini_api_key_here

# (선택) Gemini 실패 시 대체 호출용 GitHub Models 토큰
GITHUB_MODELS_TOKEN=your_github_models_token

# ── Firebase ────────────────────────────────────
FIREBASE_PROJECT_ID=popol-cb20b
FIREBASE_STORAGE_BUCKET=popol-cb20b.firebasestorage.app
# 로컬: backend/serviceAccountKey.json 파일을 두면 아래 값은 생략 가능
# 배포: 파일을 올릴 수 없으므로 serviceAccountKey.json 내용을 한 줄 JSON으로 붙여넣기 ★ 필수
# 예: {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── 이메일 발송 (SMTP) ──────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
# Gmail은 계정 비밀번호가 아니라 앱 비밀번호 사용
EMAIL_PASS=your_app_password
EMAIL_FROM=FitPoly <your_email@gmail.com>

# ── 관리자 페이지 로그인 비밀번호 (배포 시 반드시 변경) ──
ADMIN_PASSWORD=change-me

# ─────────────────────────────────────────────
# 무료 티어(예: Render 512MB) 보호 스위치 — 배포 시 권장 ON
# ─────────────────────────────────────────────
# 채용공고 URL 스크래핑 시 Chromium(Puppeteer) 실행을 끔 → OOM 방지.
# 끄면 HTTP 스크래핑/Gemini 검색 기반 분석으로 자동 전환되어 기능은 계속 동작.
PUPPETEER_DISABLED=true
# 이미지 OCR을 로컬 Tesseract 대신 Gemini Vision API로 처리 → OOM 방지.
OCR_PREFER_VISION=true
# (빌드 환경) Puppeteer 설치 시 Chromium 다운로드 생략 → 배포 용량/시간 절감.
PUPPETEER_SKIP_DOWNLOAD=true

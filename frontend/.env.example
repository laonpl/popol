# ─────────────────────────────────────────────
# Frontend 환경변수 (Vercel 대시보드 → Settings → Environment Variables에 입력)
# ─────────────────────────────────────────────

# 백엔드 API URL (Render 배포 후 설정) ★ 필수
VITE_API_URL=https://your-backend.onrender.com/api

# (선택) 피드백 관리자 화면 접근 이메일 (쉼표로 여러 개, 백엔드 ADMIN_EMAILS와 맞추기)
# VITE_ADMIN_EMAILS=admin@example.com

# Firebase 설정은 src/config/firebase.js에 하드코딩되어 있어 별도 설정 불필요

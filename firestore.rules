rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnerByUid(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsExistingByUserId() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingByUserId() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /profiles/{userId} {
      allow read, delete: if isOwnerByUid(userId);
      allow create, update: if isOwnerByUid(userId)
        && request.resource.data.uid == userId;
    }

    match /waitlist/{docId} {
      allow read, write: if false;
    }

    match /experiences/{experienceId} {
      allow read, delete: if ownsExistingByUserId();
      allow update: if ownsExistingByUserId()
        && request.resource.data.userId == request.auth.uid;
      allow create: if ownsIncomingByUserId();
    }

    match /portfolios/{portfolioId} {
      allow read: if resource.data.isPublic == true || ownsExistingByUserId();
      allow update, delete: if ownsExistingByUserId()
        && request.resource.data.userId == request.auth.uid;
      allow create: if ownsIncomingByUserId();
    }

    match /jobMatches/{matchId} {
      allow read, delete: if ownsExistingByUserId();
      allow update: if ownsExistingByUserId()
        && request.resource.data.userId == request.auth.uid;
      allow create: if ownsIncomingByUserId();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
